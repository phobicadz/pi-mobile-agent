# Pi Mobile Agent Backend Configuration

# Server port
PORT=3000

# Pi Configuration
# Provider: anthropic, openai, gemini, etc.
PI_PROVIDER=anthropic

# Model (depends on your provider)
# Anthropic: claude-3-5-sonnet-20241022, claude-3-opus-20250219
# OpenAI: gpt-4, gpt-4-turbo, gpt-4o
PI_MODEL=claude-3-5-sonnet-20241022

# Optional: Working directory for Pi agent
# PI_CWD=/path/to/project

# Optional: Session name
# PI_SESSION=mobile-agent

# CORS settings (for development)
CORS_ORIGIN=*

# Optional: Authentication token for mobile app (future feature)
# API_TOKEN=your-secret-token

# Optional: Logging level
LOG_LEVEL=info
